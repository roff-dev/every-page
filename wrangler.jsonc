// Deploy config for the Cloudflare Worker that serves the built site (static assets only, no script).
{
  "name": "every-page",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /privacy serves privacy/index.html; an unknown path gets 404.html with a 404 status
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
