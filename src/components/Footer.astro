---
import { site } from '../site';

interface Props {
  /** Offer the sound toggle (only the library itself makes any sound) */
  sound?: boolean;
}

const { sound = false } = Astro.props;
---
<footer class="footer">
  <p class="signature">Made by <a href={site.author.href}>{site.author.name}</a></p>
  <nav aria-label="About this site">
    <ul>
      <li><a href="/how-it-works">How it works</a></li>
      <li><a href="/privacy">Privacy</a></li>
      <li><a href="/terms">Terms</a></li>
      {sound && (
        <li>
          <button class="sound" type="button" aria-pressed="false" data-sound>Sound <span aria-hidden="true" data-sound-state>off</span></button>
        </li>
      )}
    </ul>
  </nav>
</footer>

<style>
  .footer {
    /* above the landing page's fixed scene, which otherwise swallows its clicks */
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    padding: var(--space-2) var(--gutter) max(var(--space-2), env(safe-area-inset-bottom));
    font-size: var(--step--1);
    color: var(--muted);
  }

  .signature {
    font-family: var(--font-display);
    font-style: italic;
    font-variation-settings: 'SOFT' 100;
  }

  ul {
    display: flex;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a,
  .sound {
    display: inline-block;
    padding-block: 0.6rem;
  }

  .sound {
    min-height: 2.75rem;
    padding-inline: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    text-decoration-color: var(--brass);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .sound:hover,
  .sound[aria-pressed='true'] [data-sound-state] {
    color: var(--lamplight);
  }
</style>
