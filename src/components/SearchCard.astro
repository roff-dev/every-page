---
/**
 * An open book to write in: the search field with its live "will read as" feedback.
 * Other ways in go in the default slot, along the foot of the page; `spread` opens it across two pages on wide screens,
 * with anything in the "verso" slot under the question on the left-hand page.
 */
interface Props {
  spread?: boolean;
}

const { spread = false } = Astro.props;
---
<form class:list={['card', { spread }]} id="search" role="search" action="/" method="get">
  <div class="verso">
    <label class="card-label" for="query">What should the library find?</label>
    <slot name="verso" />
  </div>
  <div class="recto">
    <textarea
      id="query"
      name="q"
      rows="2"
      maxlength="6000"
      autocomplete="off"
      autocapitalize="none"
      spellcheck="false"
      placeholder="A sentence, a name, a line you can't forget…"
      aria-describedby="reads-as search-note"
    ></textarea>
    <p class="reads-as" id="reads-as" data-reads-as hidden>The library will read this as <q></q></p>
    <p class="note" id="search-note" data-note role="status" hidden></p>
    <p class="trouble" data-trouble role="alert" hidden>
      The catalogue didn't answer. <button class="random" type="button" data-retry>Try again</button>
    </p>
    <div class="card-actions">
      <span class="counter" data-counter hidden></span>
      <button class="find" type="submit">Find it</button>
    </div>
    <div class="card-more">
      <slot />
    </div>
  </div>
</form>

<style>
  /* one page of a book bound on the left: the rust cover at the spine and edges, shadow into the binding */
  .card {
    position: relative;
    width: min(100%, 30rem);
    padding: var(--space-3) var(--space-3) var(--space-2) calc(var(--space-3) + 0.3rem);
    color: var(--ink);
    background:
      linear-gradient(to right, rgb(58 38 24 / 0.24), rgb(58 38 24 / 0.07) 1.3rem, transparent 2.6rem),
      radial-gradient(120% 90% at 75% 10%, #fbf4e3, var(--parchment) 65%);
    border-left: 0.4rem solid var(--rust);
    border-radius: 0.3rem 0.45rem 0.45rem 0.3rem;
    box-shadow:
      1px 1px 0 #eadab9,
      2px 2px 0 #f6eacf,
      3px 3px 0 #e3d0ab,
      4px 4px 0 #f3e5c8,
      5px 6px 0 var(--rust),
      0 28px 60px -18px rgb(0 0 0 / 0.6);
  }

  .card-label {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-1);
    line-height: 1.2;
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rust);
  }

  /* wide screens: the book lies open across two pages */
  @media (min-width: 64rem) {
    .spread {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: min(100%, 62rem);
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      perspective: 2000px;
    }

    /* the cover, standing a little proud of the pages */
    .spread::before {
      content: '';
      position: absolute;
      inset: -0.6rem -0.8rem -1rem;
      z-index: -1;
      border-radius: 0.65rem;
      background: linear-gradient(170deg, #9a4430, var(--rust) 40%, #6f2d1c);
      box-shadow: 0 40px 80px -24px rgb(0 0 0 / 0.7);
    }

    .spread .verso,
    .spread .recto {
      display: flex;
      flex-direction: column;
      min-height: 23rem;
      padding: var(--space-4) var(--space-4) var(--space-3);
    }

    .spread .verso {
      background:
        linear-gradient(to left, rgb(58 38 24 / 0.3), rgb(58 38 24 / 0.08) 1.6rem, transparent 3.6rem),
        radial-gradient(130% 90% at 15% 8%, #fbf4e3, var(--parchment) 65%);
      border-radius: 0.45rem 0.1rem 0.1rem 0.45rem;
      box-shadow: -1px 1px 0 #eadab9, -2px 2px 0 #f6eacf, -3px 3px 0 #e3d0ab, -4px 4px 0 #f3e5c8;
      transform-origin: right center;
      animation: open-verso 1100ms var(--ease-settle) 200ms both;
    }

    .spread .recto {
      background:
        linear-gradient(to right, rgb(58 38 24 / 0.3), rgb(58 38 24 / 0.08) 1.6rem, transparent 3.6rem),
        radial-gradient(130% 90% at 85% 8%, #fbf4e3, var(--parchment) 65%);
      border-radius: 0.1rem 0.45rem 0.45rem 0.1rem;
      box-shadow: 1px 1px 0 #eadab9, 2px 2px 0 #f6eacf, 3px 3px 0 #e3d0ab, 4px 4px 0 #f3e5c8;
      transform-origin: left center;
      animation: open-recto 1100ms var(--ease-settle) 200ms both;
    }

    .spread .card-label {
      font-size: var(--step-2);
      line-height: 1.1;
      padding-bottom: var(--space-2);
    }

    .spread textarea {
      margin-top: 0;
      min-height: 8em;
    }

    .spread .card-more {
      margin-top: auto;
    }
  }

  @keyframes open-verso {
    from {
      transform: rotateY(16deg);
    }
  }

  @keyframes open-recto {
    from {
      transform: rotateY(-16deg);
    }
  }

  textarea {
    display: block;
    width: 100%;
    margin-top: var(--space-1);
    padding: 0.5rem 0;
    border: 0;
    background:
      repeating-linear-gradient(transparent 0 calc(1.6em - 1px), rgb(138 59 38 / 0.25) calc(1.6em - 1px) 1.6em);
    color: var(--ink);
    font-size: var(--step-0);
    line-height: 1.6em;
    resize: none;
    field-sizing: content;
    min-height: 3.2em;
    max-height: 40dvh;
  }

  textarea::placeholder {
    color: var(--faded);
    font-style: italic;
  }

  textarea:focus-visible {
    outline: none;
    box-shadow: 0 2px 0 var(--lamplight);
  }

  .reads-as {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--faded);
  }

  .reads-as q {
    display: block;
    margin-top: 0.15rem;
    color: var(--ink);
    font-family: var(--font-page);
    font-size: 0.95em;
    quotes: none;
    overflow-wrap: anywhere;
  }

  .reads-as :global(u) {
    text-decoration-color: var(--rust);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .note,
  .trouble {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--rust);
  }

  .trouble .random {
    min-height: 2.75rem;
    margin-left: 0.3rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--rust);
    font-size: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .trouble .random:hover {
    color: var(--ink);
  }

  .counter {
    margin-right: auto;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--faded);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-2);
  }

  /* the other ways in, along the foot of the page */
  .card-more {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1);
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    padding-bottom: var(--space-1);
    border-top: 1px solid rgb(138 59 38 / 0.2);
  }

  .find {
    min-height: 2.9rem;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 0.45rem;
    background: var(--night);
    color: var(--lamplight);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-0);
    cursor: pointer;
    transition: background 200ms var(--ease-settle), transform 200ms var(--ease-settle);
  }

  .find:hover {
    background: var(--walnut);
  }

  .find:active {
    transform: translateY(1px);
  }

  .find:disabled {
    background: var(--walnut);
    color: var(--muted);
    opacity: 0.55;
    cursor: default;
  }

  .card-more :global(.more) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem 0 0.9rem;
    border: 1px solid rgb(138 59 38 / 0.55);
    border-radius: 0.45rem;
    background: rgb(138 59 38 / 0.06);
    color: var(--rust);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step--1);
    cursor: pointer;
    transition: background 200ms var(--ease-settle), border-color 200ms var(--ease-settle), color 200ms var(--ease-settle);
  }

  .card-more :global(.more:hover) {
    border-color: var(--rust);
    background: rgb(138 59 38 / 0.12);
    color: var(--ink);
  }

  .card-more :global(.more svg) {
    width: 1.45rem;
    height: 1.45rem;
    flex: none;
    stroke-width: 1.9;
  }

  /* when the two wrap onto their own rows, the second keeps to the right */
  .card-more > :global(:last-child:not(:first-child)) {
    margin-left: auto;
  }

  /* an opening quotation mark, set large */
  .card-more :global(.quote-mark) {
    font-size: 1.9em;
    line-height: 0;
    translate: 0 0.22em;
  }
</style>
