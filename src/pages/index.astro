---
import Base from '../layouts/Base.astro';
---
<Base>
  <main class="poster">
    <div class="scene" id="scene" aria-hidden="true"></div>

    <header class="masthead">
      <h1>Every Page</h1>
      <p class="lede">Every page that could ever be written is already on these shelves. Yours too.</p>
    </header>

    <form class="card" id="search" role="search" action="/" method="get">
      <label class="card-label" for="query">What should the library find?</label>
      <textarea
        id="query"
        name="q"
        rows="2"
        maxlength="6000"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder="A sentence, a name, a line you can't forget…"
      ></textarea>
      <div class="card-actions">
        <button class="find" type="submit">Find it</button>
        <button class="random" type="button" id="random">Open a random volume</button>
      </div>
    </form>
  </main>
</Base>

<style>
  .poster {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100dvh - 4.5rem);
    padding: max(var(--space-3), env(safe-area-inset-top)) var(--gutter) var(--space-2);
    isolation: isolate;
  }

  .scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 45% at 50% 62%, rgb(255 196 107 / 0.16), transparent 70%),
      radial-gradient(120% 80% at 50% 110%, #4a2a1c, var(--night) 70%);
  }

  .masthead h1 {
    max-width: 6ch;
  }

  h1 {
    font-size: var(--step-display);
    font-weight: 380;
    font-variation-settings: 'SOFT' 100;
    letter-spacing: -0.025em;
    line-height: 0.92;
    color: var(--cream);
    text-shadow: 0 0 0.6em rgb(255 196 107 / 0.18);
  }

  .lede {
    margin-top: var(--space-3);
    max-width: 24ch;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--muted);
  }

  .card {
    grid-row: 3;
    width: min(100%, 30rem);
    padding: var(--space-3) var(--space-3) var(--space-2);
    background: var(--parchment);
    color: var(--ink);
    border-radius: var(--radius-card);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 24px 60px -20px rgb(0 0 0 / 0.55);
    position: relative;
  }

  /* the punched hole of a catalogue card */
  .card::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.55rem;
    width: 0.7rem;
    height: 0.7rem;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--night);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.35);
  }

  .card-label {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-1);
    line-height: 1.2;
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rust);
  }

  textarea {
    display: block;
    width: 100%;
    margin-top: var(--space-1);
    padding: 0.5rem 0;
    border: 0;
    background:
      repeating-linear-gradient(transparent 0 calc(1.6em - 1px), rgb(138 59 38 / 0.25) calc(1.6em - 1px) 1.6em);
    color: var(--ink);
    font-size: var(--step-0);
    line-height: 1.6em;
    resize: none;
    field-sizing: content;
    min-height: 3.2em;
    max-height: 40dvh;
  }

  textarea::placeholder {
    color: var(--faded);
    font-style: italic;
  }

  textarea:focus-visible {
    outline: none;
    box-shadow: 0 2px 0 var(--lamplight);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-2);
    padding-bottom: var(--space-3);
  }

  .find {
    min-height: 2.9rem;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--night);
    color: var(--lamplight);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-0);
    cursor: pointer;
    transition: background 200ms var(--ease-settle), transform 200ms var(--ease-settle);
  }

  .find:hover {
    background: var(--walnut);
  }

  .find:active {
    transform: translateY(1px);
  }

  .random {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--rust);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .random:hover {
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .poster {
      padding-top: var(--space-5);
      padding-inline: max(var(--space-5), var(--gutter));
    }

    .card {
      margin-bottom: var(--space-3);
    }
  }
</style>
