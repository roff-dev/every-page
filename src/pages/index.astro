---
import Base from '../layouts/Base.astro';
import SearchCard from '../components/SearchCard.astro';
---
<Base sound>
  <main class="poster">
    <div class="scene" id="scene" aria-hidden="true">
      <picture>
        <source media="(orientation: portrait)" type="image/avif" srcset="/poster-tall.avif" />
        <source media="(orientation: portrait)" type="image/webp" srcset="/poster-tall.webp" />
        <source type="image/avif" srcset="/poster-wide.avif" />
        <img class="still" src="/poster-wide.webp" alt="" fetchpriority="high" decoding="async" />
      </picture>
    </div>

    <header class="masthead">
      <h1>Every Page</h1>
    </header>

    <SearchCard spread>
      <p class="lede" slot="verso">Every page that could ever be written is already on these shelves. Yours too.</p>
      <button class="more" type="button" id="random"><span class="quote-mark" aria-hidden="true">“</span>Find a famous line</button>
      <button class="more" type="button" id="wander-start">Wander the galleries <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.2 6.3A5 5 0 0 1 21.5 8.6V21" /><path d="M2.5 21h19" /><circle cx="8.6" cy="5.2" r="1.75" fill="currentColor" stroke="none" /><path d="M8.2 8.1 7 13.4" /><path d="M8 9.1l2.4 1.8 1.4-.7" /><path d="M8 9.1 5.5 11l-1.3-.6" /><path d="M7 13.4l3 2.5.7 4.3" /><path d="M7 13.4 5.4 17l-2.7.6" /></svg></button>
    </SearchCard>

    <section class="route" id="route" aria-labelledby="route-title">
      <div class="route-card">
        <p class="route-note">This browser can't draw the galleries, so here is the way to your shelf.</p>
        <h2 id="route-title">Hexagon <span class="route-hex" data-route-hex></span></h2>
        <ol class="route-steps" data-route-steps></ol>
        <button class="open-book" type="button" data-route-open>Open the book</button>
      </div>
    </section>

    <section class="journey" id="journey" aria-label="Journey to your page">
      <p class="caption" data-caption aria-live="polite"></p>
      <p class="distance" data-distance></p>
      <button class="skip" type="button" data-skip hidden>Skip</button>
      <button class="continue" type="button" data-continue hidden>Continue</button>
      <div class="veil" data-veil aria-hidden="true"></div>
    </section>

    <section class="wander" id="wander" aria-label="Wandering the library">
      <div class="wander-top">
        <div class="plaque">
          <p><span class="plaque-label">Hexagon</span> <span class="plaque-hex" data-place></span></p>
          <p class="plaque-where" data-where></p>
        </div>
        <aside class="controls" aria-labelledby="controls-title">
          <p class="controls-title" id="controls-title">Getting around</p>
          <dl data-controls></dl>
        </aside>
      </div>
      <div class="wander-bottom">
        <nav class="ways" aria-label="Ways on">
          <button type="button" data-way="west"><span aria-hidden="true">←</span> West gallery</button>
          <button type="button" data-way="east">East gallery <span aria-hidden="true">→</span></button>
          <button type="button" data-way="up"><span aria-hidden="true">↑</span> Stairs up</button>
          <button type="button" data-way="down"><span aria-hidden="true">↓</span> Stairs down</button>
        </nav>
        <div class="wander-actions">
          <button class="round" type="button" data-search>Search</button>
          <button class="round" type="button" data-random><span class="quote-mark" aria-hidden="true">“</span>Famous line</button>
          <button class="round" type="button" aria-pressed="false" data-sound>Sound <span class="round-state" aria-hidden="true" data-sound-state>off</span></button>
        </div>
      </div>
      <p class="spine-label" data-spine hidden></p>
      <div class="crosshair" data-crosshair aria-hidden="true" hidden></div>
    </section>
  </main>
</Base>

<script>
  import { boot } from '../app/main';
  boot();
</script>

<style>
  .poster {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    justify-items: center;
    min-height: calc(100dvh - 4.5rem);
    padding: max(var(--space-3), env(safe-area-inset-top)) var(--gutter) var(--space-2);
    isolation: isolate;
  }

  .scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 45% at 50% 62%, rgb(255 196 107 / 0.16), transparent 70%),
      radial-gradient(120% 80% at 50% 110%, #4a2a1c, var(--night) 70%);
  }

  /* keeps the title and lede legible over a bright scene */
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(43 23 16 / 0.82), rgb(43 23 16 / 0.45) 30%, transparent 52%),
      linear-gradient(to top, rgb(43 23 16 / 0.6), transparent 30%);
    pointer-events: none;
  }

  /* wide screens: settle the room around the open book in the middle */
  @media (min-width: 64rem) {
    .scene::after {
      background:
        radial-gradient(60% 55% at 50% 56%, rgb(43 23 16 / 0.5), rgb(43 23 16 / 0.2) 70%, transparent),
        linear-gradient(to bottom, rgb(43 23 16 / 0.7), transparent 30%),
        linear-gradient(to top, rgb(43 23 16 / 0.5), transparent 25%);
    }
  }

  .still,
  .scene :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scene :global(canvas) {
    opacity: 0;
    transition: opacity 1.4s var(--ease-settle);
  }

  .scene :global(canvas.shown) {
    opacity: 1;
  }

  .masthead {
    justify-self: stretch;
  }

  h1 {
    font-size: clamp(2.6rem, 1.9rem + 3vw, 4.8rem);
    font-weight: 380;
    font-variation-settings: 'SOFT' 100;
    letter-spacing: -0.025em;
    line-height: 0.92;
    color: var(--cream);
    text-shadow: 0 0 0.6em rgb(255 196 107 / 0.18);
  }

  /* under the question on the book's first page */
  .lede {
    margin-top: var(--space-1);
    max-width: 30ch;
    font-style: italic;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--faded);
  }

  .poster > :global(.card) {
    grid-row: 2;
    align-self: center;
    margin-block: var(--space-4);
  }

  @media (min-width: 64rem) {
    .masthead {
      text-align: center;
    }

    .lede {
      margin-top: auto;
      padding-top: var(--space-3);
      font-size: var(--step-0);
      max-width: 24ch;
    }
  }

  .masthead,
  .poster > :global(.card) {
    transition: opacity 600ms var(--ease-settle), translate 600ms var(--ease-settle);
  }

  :global(body[data-state='journey']) .masthead,
  :global(body[data-state='journey'] .card),
  :global(body[data-state='reading']) .masthead,
  :global(body[data-state='reading'] .card),
  :global(body[data-state='route']) .masthead,
  :global(body[data-state='route'] .card) {
    opacity: 0;
    translate: 0 1.5rem;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 600ms var(--ease-settle), translate 600ms var(--ease-settle), visibility 0s 600ms;
  }

  :global(body[data-state='journey']) .scene::after,
  :global(body[data-state='reading']) .scene::after {
    opacity: 0.35;
  }

  .scene::after {
    transition: opacity 1s var(--ease-settle);
  }

  :global(body:is([data-state='journey'], [data-state='reading'], [data-state='wander'], [data-state='route']) .footer) {
    visibility: hidden;
  }

  .journey {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .caption {
    position: absolute;
    left: 50%;
    top: max(14%, calc(env(safe-area-inset-top) + 4.5rem));
    width: min(100% - 2 * var(--gutter), 38rem);
    translate: -50% 0.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.25;
    text-wrap: balance;
    color: var(--cream);
    text-shadow: 0 1px 18px rgb(43 23 16 / 0.9), 0 0 2px rgb(43 23 16 / 0.6);
    opacity: 0;
    transition: opacity 800ms var(--ease-settle), translate 800ms var(--ease-settle);
  }

  .caption:global(.shown) {
    opacity: 1;
    translate: -50% 0;
  }

  .distance {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: max(var(--space-3), env(safe-area-inset-bottom));
    font-family: var(--font-page);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    text-shadow: 0 1px 10px rgb(43 23 16 / 0.9);
  }

  .distance :global(sup) {
    font-size: 0.7em;
  }

  .skip {
    position: absolute;
    top: max(var(--space-2), env(safe-area-inset-top));
    right: var(--gutter);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--brass);
    border-radius: 999px;
    background: rgb(43 23 16 / 0.55);
    color: var(--cream);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    pointer-events: auto;
    cursor: pointer;
  }

  .skip:hover {
    border-color: var(--lamplight);
  }

  .continue {
    position: absolute;
    left: 50%;
    bottom: max(calc(var(--space-4) + 1.5rem), calc(env(safe-area-inset-bottom) + var(--space-4)));
    translate: -50% 0;
    min-height: 3rem;
    padding: 0 1.6rem;
    border: 0;
    border-radius: 999px;
    background: var(--lamplight);
    color: var(--night);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-0);
    box-shadow: 0 10px 30px -10px rgb(0 0 0 / 0.6);
    pointer-events: auto;
    cursor: pointer;
  }

  .continue:hover {
    background: #ffd38f;
  }

  .veil {
    position: absolute;
    inset: 0;
    background: var(--night);
    opacity: 0;
  }

  .wander {
    position: fixed;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms var(--ease-settle), visibility 0s 500ms;
  }

  :global(body[data-state='wander']) .wander {
    opacity: 1;
    visibility: visible;
    transition: opacity 500ms var(--ease-settle);
  }

  :global(body[data-state='wander']) .masthead,
  :global(body[data-state='wander'] .card) {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  :global(body[data-state='wander']) .scene::after {
    opacity: 0.25;
  }

  :global(body[data-state='wander']) {
    overflow: hidden;
  }

  :global(body[data-state='wander'] .scene canvas) {
    touch-action: none;
    cursor: grab;
  }

  .wander > * {
    pointer-events: auto;
  }

  /* the plaque and the controls card are small pages, bound in the same rust as the landing's book */
  .wander-top {
    position: absolute;
    top: max(var(--space-2), env(safe-area-inset-top));
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-1);
    pointer-events: none;
  }

  .plaque,
  .controls {
    padding: 0.55rem 0.9rem 0.6rem 1rem;
    color: var(--ink);
    background:
      linear-gradient(to right, rgb(58 38 24 / 0.18), transparent 1.2rem),
      var(--parchment);
    border-left: 0.3rem solid var(--rust);
    border-radius: 0.3rem 0.45rem 0.45rem 0.3rem;
    box-shadow:
      1px 1px 0 #eadab9,
      2px 2px 0 #e3d0ab,
      0 14px 30px -14px rgb(0 0 0 / 0.65);
    font-size: var(--step--1);
    pointer-events: auto;
  }

  .plaque-label {
    color: var(--faded);
  }

  .plaque-hex {
    font-family: var(--font-page);
  }

  /* one line per way walked, then where it's counted from */
  .plaque-where {
    margin-top: 0.3rem;
    line-height: 1.35;
    white-space: pre-line;
  }

  .controls {
    margin-left: auto;
    line-height: 1.3;
  }

  .controls-title {
    margin-bottom: 0.4rem;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-0);
  }

  .controls :global(dl) {
    display: grid;
    grid-template-columns: auto auto;
    align-items: baseline;
    gap: 0.35rem 0.75rem;
    margin: 0;
  }

  .controls :global(dt) {
    white-space: nowrap;
  }

  .controls :global(dd) {
    margin: 0;
    color: var(--faded);
  }

  .controls :global(kbd) {
    display: inline-block;
    min-width: 1.5em;
    padding: 0.05rem 0.35rem;
    border: 1px solid rgb(138 59 38 / 0.45);
    border-bottom-width: 2px;
    border-radius: 0.25rem;
    background: #fbf4e3;
    color: var(--rust);
    font-family: var(--font-page);
    font-size: 0.95em;
    line-height: 1.3;
    text-align: center;
  }

  /* when the two groups can't sit side by side, the actions rise above the ways on */
  .wander-bottom {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: max(var(--space-2), env(safe-area-inset-bottom));
    display: flex;
    flex-wrap: wrap-reverse;
    /* wrap-reverse flips the cross axis, so this sits both groups on the bottom edge */
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.4rem;
    pointer-events: none;
  }

  .wander-bottom > * {
    pointer-events: auto;
  }

  .ways {
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.4rem;
  }

  /* the landing book's buttons, set on the scene */
  .ways button,
  .round {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid rgb(138 59 38 / 0.55);
    border-radius: 0.45rem;
    background: var(--parchment);
    color: var(--rust);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step--1);
    box-shadow: 0 12px 26px -12px rgb(0 0 0 / 0.65);
    cursor: pointer;
    transition: background 200ms var(--ease-settle), border-color 200ms var(--ease-settle), color 200ms var(--ease-settle);
  }

  .ways button:hover,
  .round:hover {
    border-color: var(--rust);
    background: #fbf4e3;
    color: var(--ink);
  }

  .wander-actions {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-left: auto;
  }

  @media (max-width: 24.9rem) {
    .wander-actions {
      flex-direction: row;
    }
  }

  /* narrow screens: labels wrap so the three fit beside the ways on */
  .round {
    flex-direction: column;
    gap: 0;
    width: 4.9rem;
    min-height: 3.4rem;
    padding: 0.3rem;
    line-height: 1.15;
  }

  .round .quote-mark {
    font-size: 1.6em;
    line-height: 0.6;
    translate: 0 0.15em;
  }

  .round-state {
    color: var(--faded);
  }

  .round[aria-pressed='true'] .round-state {
    color: var(--rust);
    font-weight: 600;
  }

  @media (min-width: 40rem) {
    .round {
      flex-direction: row;
      gap: 0.4rem;
      width: auto;
      min-width: 9rem;
      min-height: 2.75rem;
      padding: 0 1rem;
    }

    .round .quote-mark {
      font-size: 1.9em;
      line-height: 0;
      translate: 0 0.22em;
    }
  }

  .crosshair {
    position: fixed;
    left: 50%;
    top: 50%;
    width: 1.1rem;
    height: 1.1rem;
    translate: -50% -50%;
    border: 1.5px solid rgb(255 241 220 / 0.85);
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgb(43 23 16 / 0.45), inset 0 0 0 1px rgb(43 23 16 / 0.45);
    pointer-events: none;
  }

  .crosshair::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 3px;
    height: 3px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--lamplight);
  }

  .crosshair[hidden] {
    display: none;
  }

  .spine-label {
    position: fixed;
    left: 0;
    top: 0;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--brass);
    border-radius: 0.3rem;
    background: var(--night);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step--1);
    pointer-events: none;
    white-space: nowrap;
  }

  /* without WebGL: the way to the shelf, drawn as a route card */
  :global(body.reading-room) #wander-start {
    display: none;
  }

  .route {
    position: fixed;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: var(--space-3) var(--gutter);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    transition: opacity 500ms var(--ease-settle), visibility 0s 500ms;
  }

  :global(body[data-state='route']) .route {
    opacity: 1;
    visibility: visible;
    transition: opacity 500ms var(--ease-settle);
  }

  .route-card {
    width: min(100%, 40rem);
    padding: var(--space-4) var(--space-3) var(--space-3);
    border-radius: var(--radius-card);
    background: var(--parchment);
    color: var(--ink);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.55);
  }

  .route-note {
    font-size: var(--step--1);
    color: var(--faded);
  }

  .route h2 {
    margin-top: var(--space-1);
    font-size: var(--step-2);
  }

  .route-hex {
    font-family: var(--font-page);
    font-size: 0.6em;
    overflow-wrap: anywhere;
  }

  .route-steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3) var(--space-2);
    margin: var(--space-3) 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .route-steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .route-steps :global(li) {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .route-steps :global(svg) {
    width: 100%;
    max-width: 7rem;
    height: auto;
  }

  .route-steps :global(.what) {
    font-size: var(--step--1);
    color: var(--faded);
  }

  .route-steps :global(.which) {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-1);
    line-height: 1.1;
  }

  .open-book {
    min-height: 2.9rem;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--night);
    color: var(--lamplight);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-0);
    cursor: pointer;
  }

  .open-book:hover {
    background: var(--walnut);
  }

  /* short screens (a phone on its side): keep the book in view */
  @media (max-height: 30rem) {
    h1 {
      font-size: 2.2rem;
    }

    .poster > :global(.card) {
      margin-block: var(--space-2);
    }
  }

  @media (min-width: 64rem) {
    .poster {
      padding-top: var(--space-4);
      padding-inline: max(var(--space-5), var(--gutter));
    }
  }
</style>
