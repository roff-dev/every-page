---
import Base from '../layouts/Base.astro';
---
<Base>
  <main class="poster">
    <div class="scene" id="scene" aria-hidden="true">
      <picture>
        <source media="(orientation: portrait)" type="image/avif" srcset="/poster-tall.avif" />
        <source media="(orientation: portrait)" type="image/webp" srcset="/poster-tall.webp" />
        <source type="image/avif" srcset="/poster-wide.avif" />
        <img class="still" src="/poster-wide.webp" alt="" fetchpriority="high" decoding="async" />
      </picture>
    </div>

    <header class="masthead">
      <h1>Every Page</h1>
      <p class="lede">Every page that could ever be written is already on these shelves. Yours too.</p>
    </header>

    <form class="card" id="search" role="search" action="/" method="get">
      <label class="card-label" for="query">What should the library find?</label>
      <textarea
        id="query"
        name="q"
        rows="2"
        maxlength="6000"
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder="A sentence, a name, a line you can't forget…"
        aria-describedby="reads-as search-note"
      ></textarea>
      <p class="reads-as" id="reads-as" data-reads-as hidden>The library will read this as <q></q></p>
      <p class="note" id="search-note" data-note role="status" hidden></p>
      <div class="card-actions">
        <button class="find" type="submit">Find it</button>
        <button class="random" type="button" id="random">Open a random volume</button>
        <span class="counter" data-counter hidden></span>
      </div>
    </form>

    <section class="journey" id="journey" aria-label="Journey to your page">
      <p class="caption" data-caption aria-live="polite"></p>
      <p class="distance" data-distance></p>
      <button class="skip" type="button" data-skip hidden>Skip</button>
      <div class="veil" data-veil aria-hidden="true"></div>
    </section>
  </main>
</Base>

<script>
  import { boot } from '../app/main';
  boot();
</script>

<style>
  .poster {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: calc(100dvh - 4.5rem);
    padding: max(var(--space-3), env(safe-area-inset-top)) var(--gutter) var(--space-2);
    isolation: isolate;
  }

  .scene {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(60% 45% at 50% 62%, rgb(255 196 107 / 0.16), transparent 70%),
      radial-gradient(120% 80% at 50% 110%, #4a2a1c, var(--night) 70%);
  }

  /* keeps the title and lede legible over a bright scene */
  .scene::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgb(43 23 16 / 0.82), rgb(43 23 16 / 0.45) 30%, transparent 52%),
      linear-gradient(to top, rgb(43 23 16 / 0.6), transparent 30%);
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .scene::after {
      background:
        radial-gradient(70% 75% at 0% 0%, rgb(43 23 16 / 0.85), rgb(43 23 16 / 0.4) 55%, transparent 80%),
        linear-gradient(to top, rgb(43 23 16 / 0.5), transparent 25%);
    }
  }

  .still,
  .scene :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scene :global(canvas) {
    opacity: 0;
    transition: opacity 1.4s var(--ease-settle);
  }

  .scene :global(canvas.shown) {
    opacity: 1;
  }

  .masthead h1 {
    max-width: 6ch;
  }

  h1 {
    font-size: var(--step-display);
    font-weight: 380;
    font-variation-settings: 'SOFT' 100;
    letter-spacing: -0.025em;
    line-height: 0.92;
    color: var(--cream);
    text-shadow: 0 0 0.6em rgb(255 196 107 / 0.18);
  }

  .lede {
    margin-top: var(--space-3);
    max-width: 24ch;
    font-size: var(--step-1);
    line-height: 1.35;
    color: var(--muted);
  }

  .card {
    grid-row: 3;
    width: min(100%, 30rem);
    padding: var(--space-3) var(--space-3) var(--space-2);
    background: var(--parchment);
    color: var(--ink);
    border-radius: var(--radius-card);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.5) inset,
      0 24px 60px -20px rgb(0 0 0 / 0.55);
    position: relative;
  }

  /* the punched hole of a catalogue card */
  .card::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.55rem;
    width: 0.7rem;
    height: 0.7rem;
    translate: -50% 0;
    border-radius: 50%;
    background: var(--night);
    box-shadow: 0 1px 0 rgb(255 255 255 / 0.35);
  }

  .card-label {
    display: block;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-1);
    line-height: 1.2;
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--rust);
  }

  textarea {
    display: block;
    width: 100%;
    margin-top: var(--space-1);
    padding: 0.5rem 0;
    border: 0;
    background:
      repeating-linear-gradient(transparent 0 calc(1.6em - 1px), rgb(138 59 38 / 0.25) calc(1.6em - 1px) 1.6em);
    color: var(--ink);
    font-size: var(--step-0);
    line-height: 1.6em;
    resize: none;
    field-sizing: content;
    min-height: 3.2em;
    max-height: 40dvh;
  }

  textarea::placeholder {
    color: var(--faded);
    font-style: italic;
  }

  textarea:focus-visible {
    outline: none;
    box-shadow: 0 2px 0 var(--lamplight);
  }

  .reads-as {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--faded);
  }

  .reads-as q {
    display: block;
    margin-top: 0.15rem;
    color: var(--ink);
    font-family: var(--font-page);
    font-size: 0.95em;
    quotes: none;
    overflow-wrap: anywhere;
  }

  .reads-as :global(u) {
    text-decoration-color: var(--rust);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.18em;
  }

  .note {
    margin-top: var(--space-1);
    font-size: var(--step--1);
    color: var(--rust);
  }

  .counter {
    margin-left: auto;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--faded);
  }

  .find:disabled {
    background: var(--walnut);
    color: var(--muted);
    opacity: 0.55;
    cursor: default;
  }

  .masthead,
  .card {
    transition: opacity 600ms var(--ease-settle), translate 600ms var(--ease-settle);
  }

  :global(body[data-state='journey']) .masthead,
  :global(body[data-state='journey']) .card,
  :global(body[data-state='reading']) .masthead,
  :global(body[data-state='reading']) .card {
    opacity: 0;
    translate: 0 1.5rem;
    pointer-events: none;
    visibility: hidden;
    transition: opacity 600ms var(--ease-settle), translate 600ms var(--ease-settle), visibility 0s 600ms;
  }

  :global(body[data-state='journey']) .scene::after,
  :global(body[data-state='reading']) .scene::after {
    opacity: 0.35;
  }

  .scene::after {
    transition: opacity 1s var(--ease-settle);
  }

  .journey {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }

  .caption {
    position: absolute;
    left: 50%;
    top: max(14%, calc(env(safe-area-inset-top) + 4.5rem));
    width: min(100% - 2 * var(--gutter), 38rem);
    translate: -50% 0.5rem;
    text-align: center;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-style: italic;
    font-size: var(--step-2);
    line-height: 1.25;
    text-wrap: balance;
    color: var(--cream);
    text-shadow: 0 1px 18px rgb(43 23 16 / 0.9), 0 0 2px rgb(43 23 16 / 0.6);
    opacity: 0;
    transition: opacity 800ms var(--ease-settle), translate 800ms var(--ease-settle);
  }

  .caption:global(.shown) {
    opacity: 1;
    translate: -50% 0;
  }

  .distance {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: max(var(--space-3), env(safe-area-inset-bottom));
    font-family: var(--font-page);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    text-shadow: 0 1px 10px rgb(43 23 16 / 0.9);
  }

  .distance :global(sup) {
    font-size: 0.7em;
  }

  .skip {
    position: absolute;
    top: max(var(--space-2), env(safe-area-inset-top));
    right: var(--gutter);
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--brass);
    border-radius: 999px;
    background: rgb(43 23 16 / 0.55);
    color: var(--cream);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    pointer-events: auto;
    cursor: pointer;
  }

  .skip:hover {
    border-color: var(--lamplight);
  }

  .veil {
    position: absolute;
    inset: 0;
    background: var(--night);
    opacity: 0;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
    margin-top: var(--space-2);
    padding-bottom: var(--space-3);
  }

  .find {
    min-height: 2.9rem;
    padding: 0 1.4rem;
    border: 0;
    border-radius: 999px;
    background: var(--night);
    color: var(--lamplight);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--step-0);
    cursor: pointer;
    transition: background 200ms var(--ease-settle), transform 200ms var(--ease-settle);
  }

  .find:hover {
    background: var(--walnut);
  }

  .find:active {
    transform: translateY(1px);
  }

  .random {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--rust);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .random:hover {
    color: var(--ink);
  }

  @media (min-width: 64rem) {
    .poster {
      padding-top: var(--space-5);
      padding-inline: max(var(--space-5), var(--gutter));
    }

    .card {
      margin-bottom: var(--space-3);
    }
  }
</style>
